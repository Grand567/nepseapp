{
  "appId": "com.smartwealth.nepse",
  "appName": "Drabyashree NEPSE",
  "webDir": "dist",
  "backgroundColor": "#080c14",
  "android": {
    "backgroundColor": "#080c14",
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"],
      "iconColor": "#10B981"
    }
  },
  "server": {
    "cleartext": false,
    "allowNavigation": [
      "drabyashree-nepse-hub6936.vercel.app",
      "*.vercel.app",
      "nepseapp.onrender.com",
      "*.onrender.com",
      "drabyashree-nepse-hub-11ef9.firebaseapp.com",
      "*.firebaseapp.com",
      "drabyashree-nepse-hub-11ef9.firebasestorage.app",
      "*.firebasestorage.app",
      "accounts.google.com",
      "identitytoolkit.googleapis.com",
      "securetoken.googleapis.com"
    ]
  }
}