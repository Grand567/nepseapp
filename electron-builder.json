{
  "appId": "com.smartwealth.nepse",
  "productName": "Drabyashree NEPSE",
  "directories": {
    "output": "dist-electron"
  },
  "electronVersion": "31.7.7",
  "npmRebuild": false,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "portable",
      "nsis"
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Drabyashree NEPSE"
  },
  "extraResources": [
    {
      "from": "proxy",
      "to": "proxy",
      "filter": [
        "**/*.mjs",
        "**/*.js",
        "data/drabyashree_ledger.db*",
        "data/broker_matrix_latest.json",
        "data/nepse-1year-market-history.json.gz",
        "data/subfiles/**/*",
        "data/today_*.json*",
        "!proxy/**/*",
        "!data/sync_vaults/**/*",
        "!data/sync_vaults*.*",
        "!data/*_seed.json",
        "!data/telegram_config.json",
        "!data/telegram_offset.json",
        "!data/discord_config.json",
        "!data/push_tokens.json",
        "!meroshare_accounts.json",
        "!data/floorsheet-full-*.json",
        "!data/broker_vault/**/*",
        "!data/broker_alltime/**/*",
        "!data/raw_floorsheet_backups/**/*",
        "!data/daily_floorsheets/**/*",
        "!node_modules/**/*",
        "!scratch/**/*",
        "!.env*"
      ]
    }
  ]
}
