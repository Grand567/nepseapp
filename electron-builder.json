{
  "appId": "com.smartwealth.nepse",
  "productName": "Drabyashree NEPSE",
  "directories": {
    "output": "dist-electron"
  },
  "electronVersion": "31.7.7",
  "npmRebuild": false,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "portable",
      "nsis"
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Drabyashree NEPSE"
  },
  "extraResources": [
    {
      "from": "proxy",
      "to": "proxy",
      "filter": [
        "**/*.mjs",
        "**/*.js",
        "**/*.json",
        "data/**/*",
        "!node_modules/**/*",
        "!scratch/**/*"
      ]
    }
  ]
}