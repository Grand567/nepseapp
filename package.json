{
  "name": "nepse-app",
  "private": true,
  "type": "module",
  "version": "1.0.6",
  "description": "Drabyashree NEPSE App",
  "author": "Rexsh K Suwal (+977 9841576936)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node --max-old-space-size=450 proxy/server.mjs",
    "dev": "concurrently \"vite\" \"npm run start --prefix proxy\"",
    "build": "vite build",
    "test": "node tests/runAll.mjs",
    "audit:app": "node scripts/fullAppAudit.mjs",
    "audit:prod": "node scripts/fullAppAudit.mjs --prod",
    "audit:export": "node scripts/exportForGemini4Argon.mjs",
    "export:argon": "node scripts/exportForGemini4Argon.mjs",
    "audit:ai-guru": "node scripts/exportAiGuruForArgon.mjs",
    "export:ai-guru": "node scripts/exportAiGuruForArgon.mjs",
    "preview": "vite preview",
    "whitelabel": "node white-label.mjs",
    "desktop": "electron .",
    "build:pc": "npm run build && electron-builder --win",
    "build:pc:portable": "npm run build && electron-builder --win portable",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:build-debug": "npm run mobile:sync && cd android && .\\gradlew.bat assembleDebug && node -e \"const fs=require('fs');fs.copyFileSync('./app/build/outputs/apk/debug/Drabyashree-NEPSE-debug.apk','../Drabyashree-NEPSE-debug.apk');fs.copyFileSync('./app/build/outputs/apk/debug/Drabyashree-NEPSE-debug.apk','../Drabyashree-NEPSE.apk');\"",
    "mobile:build-release": "npm run mobile:sync && cd android && .\\gradlew.bat assembleRelease && node -e \"const fs=require('fs');fs.copyFileSync('./app/build/outputs/apk/release/Drabyashree-NEPSE-release.apk','../Drabyashree-NEPSE-release.apk');fs.copyFileSync('./app/build/outputs/apk/release/Drabyashree-NEPSE-release.apk','../Drabyashree-NEPSE.apk');\"",
    "build:apk": "npm run mobile:build-release"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@rumess/nepse-api": "^1.0.5",
    "axios": "^1.16.1",
    "axios-cookiejar-support": "^7.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.5.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.395.0",
    "nepseman-api": "^1.0.0",
    "node-cache": "^5.1.2",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^5.3.1"
  }
}
