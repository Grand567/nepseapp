# proxy/.env - SAFE VERSION
# Never commit real keys to .env files that go to GitHub
# Add proxy/.env to .gitignore

PORT=5000
NODE_ENV=development

# AI Keys - Set in Render dashboard, not here
# GLM_API_KEY=your_new_key_after_regenerating
# GEMINI_API_KEY=your_gemini_key

# ─── MeroShare Credential Vault Encryption Key (Required in Production) ─────────
# Generates AES-256-CBC cipher keys via SHA-256 digest. Generate with: openssl rand -hex 32
# MEROSHARE_ENCRYPTION_KEY=your_secure_random_key_here
# Optional key used only for decrypting credentials stored under a previous rotation:
# MEROSHARE_ENCRYPTION_KEY_PREVIOUS=your_previous_key_here

# ─── Cloudflare R2 Cloud Archive (10 GB Free Forever, $0.00 Egress Fees) ──────
# Archives NEPSE tick floorsheets from past to present without consuming Render RAM
# Create token at: Cloudflare Dashboard -> R2 Object Storage -> Manage API Tokens
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=drabyashree-floorsheets
# R2_PUBLIC_URL=
